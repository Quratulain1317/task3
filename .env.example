# ==========================================
# LangSmith Configuration (Observability)
# ==========================================
# Enable LangSmith tracing to visualize and debug chain execution.
# Set to 'false' to disable logging to the cloud.
LANGCHAIN_TRACING_V2=true

# Your unique API key from https://smith.langchain.com/ settings.
# Required if tracing is enabled.
LANGCHAIN_API_KEY=your_langsmith_api_key_here

# The name of the project where these traces will be grouped in the LangSmith UI.
# Useful for separating 'dev', 'prod', or specific experiments.
LANGCHAIN_PROJECT=langchain-rag-learning

# The ingestion endpoint for LangSmith.
# Usually does not need changing unless you are self-hosting LangSmith.
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com


# ==========================================
# Ollama Configuration (Local Inference)
# ==========================================
# The URL where your local Ollama instance is running.
# Default is http://localhost:11434. Ensure Ollama is running (`ollama serve`).
OLLAMA_BASE_URL=http://localhost:11434

# The specific LLM to use for generation (e.g., llama3, mistral, gemma).
# Must be pulled locally via `ollama pull <model_name>`.
OLLAMA_MODEL=llama3

# The model used to convert text into vector embeddings.
# 'nomic-embed-text' is recommended for high-performance retrieval tasks.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text


# ==========================================
# ChromaDB Configuration (Vector Store)
# ==========================================
# The local directory where vector embeddings will be saved.
# Using a persistent directory prevents rebuilding the index on every restart.
CHROMA_PERSIST_DIRECTORY=./data/chroma_db


# ==========================================
# Document Processing (Splitting)
# ==========================================
# The maximum number of characters (or tokens, depending on splitter) per text chunk.
# - Larger chunks = More context per retrieved result, but uses more LLM context window.
# - Smaller chunks = More granular retrieval, but might cut off semantic meaning.
CHUNK_SIZE=1000

# The number of characters to overlap between adjacent chunks.
# Crucial for maintaining context continuity (e.g., keeping sentences together)
# across split boundaries.
CHUNK_OVERLAP=200


# ==========================================
# Retrieval Configuration (RAG)
# ==========================================
# The number of most relevant document chunks to retrieve from the vector store.
# - Higher K = More information for the LLM, higher latency, higher token cost.
# - Lower K = Faster, cheaper, but risk of missing relevant details.
RETRIEVAL_K=4